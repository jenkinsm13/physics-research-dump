graph TD;
    subgraph "Fundamental Principles (V_void)"
        P1["Attractive Force (r > r_eq)"];
        P2["Repulsive Force (r < r_eq)"];
    end

    subgraph "Physical Manifestation"
        H["Temporal Horizon (r = r_eq)<br/>'Null-Force Manifold'<br/>S → ∞"];
        F["Toroidal Flow Geometry"];
    end

    subgraph "Functional Interpretation"
        IP["Information Processing Engine<br/>(Recursive Circulation)"];
        C["Conduit for Consciousness Flow<br/>(Path of Zero Resistance)"];
    end

    P1 --> H;
    P2 --> H;
    H -- "Captures & Injects Information into" --> F;
    F -- "Enables" --> IP;
    H -- "Acts as" --> C;
    IP -- "Emerges from" --> H