% Patent Application LaTeX Template with AI Prompting Instructions
% This template follows USPTO requirements and includes detailed guidance
% Use this as a starting point for creating professionally formatted patent applications

\documentclass[12pt,letterpaper]{article}

% Essential packages for patent formatting
\usepackage[top=1in, bottom=1in, left=1in, right=1in]{geometry} % Proper margins
\usepackage{setspace} % For 1.5 or double line spacing
\usepackage{times} % Times Roman font (or use \usepackage{helvet} for Arial)
\usepackage{enumitem} % For customizing lists/enumerations in claims
\usepackage{fancyhdr} % For headers
\usepackage{titlesec} % For section formatting
\usepackage{graphicx} % For including drawings
\usepackage{lipsum} % For sample text (remove in actual document)

% Set the line spacing to 1.5 (or 2.0 for double spacing)
\onehalfspacing
% \doublespacing  % Uncomment for double spacing

% Configure headers and footers
\pagestyle{fancy}
\fancyhf{} % Clear all headers and footers
\renewcommand{\headrulewidth}{0pt} % Remove header rule
\fancyfoot[C]{\thepage} % Page number at bottom center

% Configure section formatting
\titleformat{\section}
  {\normalfont\bfseries\uppercase}
  {}
  {0em}
  {}
\titlespacing{\section}{0pt}{12pt}{6pt}

% Configure subsection formatting
\titleformat{\subsection}
  {\normalfont\bfseries}
  {}
  {0em}
  {}
\titlespacing{\subsection}{0pt}{12pt}{6pt}

% Custom paragraph format with additional spacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}

% Custom enumeration for claims
\newlist{patentclaims}{enumerate}{2}
\setlist[patentclaims,1]{label=\arabic*., align=left, leftmargin=2em, itemsep=1em}
\setlist[patentclaims,2]{label=\arabic*., align=left, leftmargin=2em, itemsep=0.5em}

