\section*{CLAIMS}

% INSTRUCTIONS: Begin with independent claims defining the broadest protection scope, followed by dependent claims adding specific limitations. Each claim must be a single sentence. For AI prompting: "Draft patent claims starting with the broadest independent claim that captures the inventive concept. Follow with dependent claims that add specific limitations. Each claim must be a single sentence beginning with 'A [device/method/system]' for independent claims or 'The [device/method/system] of claim X' for dependent claims. Ensure claims are clear, complete, and supported by the description."

\begin{patentclaims}
    \item A device comprising:
    \begin{itemize}[leftmargin=2em]
        \item a housing;
        \item a component disposed within the housing; and
        \item a mechanism operatively connected to the component,
        \item wherein the mechanism is configured to perform a function.
    \end{itemize}
    
    \item The device of claim 1, wherein the housing includes a first portion and a second portion connected by a hinge.
    
    \item The device of claim 2, wherein the first portion includes a display.
    
    \item The device of claim 1, wherein the component comprises a processor and a memory.
    
    \item The device of claim 4, wherein the memory stores instructions that, when executed by the processor, cause the device to:
    \begin{itemize}[leftmargin=2em]
        \item detect a first condition;
        \item activate the mechanism in response to detecting the first condition; and
        \item perform the function.
    \end{itemize}
    
    \item A method comprising:
    \begin{itemize}[leftmargin=2em]
        \item detecting, by a device, a condition;
        \item activating, in response to the condition, a mechanism of the device; and
        \item performing, by the mechanism, a function.
    \end{itemize}
    
    \item The method of claim 6, further comprising:
    \begin{itemize}[leftmargin=2em]
        \item receiving user input; and
        \item modifying the function based on the user input.
    \end{itemize}
\end{patentclaims}

